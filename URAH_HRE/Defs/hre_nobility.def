// Title sets for the HRE map's princes, churches and cities (kingdoms.csv NobilityTitles, written by
// tools/import_hre.py from data/period_kingdoms.csv). Levels: Duchy / Kingdom / Empire; King / Queen
// follow Nobility.title_keys (Duchy -> Duke / Duchess). German texts: Texts/de/de_hre_*.csv.

def ArchbishopNobility : Nobility
{
	Duchy = "Archbishopric"
	Kingdom = "Archbishopric"
	Duke = "Archbishop"
	Duchess = "Abbess"
	King = "Archbishop"
	Queen = "Abbess"
}

