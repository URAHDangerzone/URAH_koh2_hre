// URAH HRE map: province features. Vanilla spawns Camels in the southern 23 % of the map
// (ProvinceFeatures.def `area`), which on the HRE map is Italy and the Balkans; no camels there.
// Pirates need has_distant_port, which tools/import_hre.py sets from data/pirate_provinces.txt.
Camels.spawn_chance = 0

// Feature spread, weighted by the goods a feature gives when fully built up (tools/hre/sim_features.py
// GOODS): deep forests 6, cattle 5, herbs 5, sheep 4, flax 4, vines 3, marble 3, horses 2, the ores and
// deposits 1 each. A merchant trades only 3 goods, so the many-goods features (special settlements,
// hre_settlements.def) are made more common and the single-good castle resources rarer: those are easy
// to trade for. The castle tries its resources one after the other until one hits, so the chances have
// to go well below vanilla to show.
RareGame.spawn_chance = 18
{
	Mountains = -12  // game of the lowland forests, like horses (hre_settlements.def)
}
MineralsDeposit.spawn_chance = 19
SulfurDeposits.spawn_chance = 11
SaltpeterDeposits.spawn_chance = 9
SaltDeposit.spawn_chance = 13  // + 12 coastal, + 12 mountains (vanilla); salt is a staple, ~13 % of the provinces
AmberDeposits.spawn_chance = 30
// mining regions: gold, silver and lodestone cluster in the mountains (mostly the Alps), about 3x
// (`Mountains` adds to the chance in realms with has_mountains). The ores come only as a mine's
// secondary feature, so the mines move to the mountains too (hre_settlements.def)
GoldOre.spawn_chance = 30
{
	Mountains = 45
}
SilverOre.spawn_chance = 40
{
	Mountains = 45
}
LodestoneDeposits.spawn_chance = 40
{
	Mountains = 40
}
// vanilla's areas are fitted to the whole of Europe; on the HRE frame (44-56 N) they would keep vines
// and logging camps out of Italy and mines (gold) out of the north. Vineyards follow wine_region instead
Vines.area = [0, 0, 1, 1]
GoldOre.area = [0, 0, 1, 1]
DeepForests.area = [0, 0, 1, 1]
