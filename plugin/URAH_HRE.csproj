<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>URAH_HRE</AssemblyName>
    <RootNamespace>URAH_HRE</RootNamespace>
    <URAHModLink>true</URAHModLink>
    <!-- shared/ of the workspace (URAH_koh2_knowledge) when there, else the submodule -->
    <URAHShared Condition="'$(URAHShared)' == '' and Exists('$(MSBuildProjectDirectory)/../../../shared/URAH.Plugin.props')">$(MSBuildProjectDirectory)/../../../shared</URAHShared>
    <URAHShared Condition="'$(URAHShared)' == ''">$(MSBuildProjectDirectory)/../external/URAH_shared</URAHShared>
  </PropertyGroup>

  <Import Project="$(URAHShared)/URAH.Plugin.props" />

  <ItemGroup>
    <Reference Include="UnityEngine.TerrainModule" HintPath="$(ManagedDir)/UnityEngine.TerrainModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ManagedDir)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ManagedDir)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(ManagedDir)/UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(ManagedDir)/UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="Unity.Collections" HintPath="$(ManagedDir)/Unity.Collections.dll" Private="false" />
  </ItemGroup>

  <!-- URAH_MapKit loads as its own plugin (BepInDependency): referenced, never copied. The workspace
       builds it alongside; a standalone checkout compiles against the installed copy -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/../../mapkit/plugin/URAH_MapKit.csproj')">
    <ProjectReference Include="$(MSBuildProjectDirectory)/../../mapkit/plugin/URAH_MapKit.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(MSBuildProjectDirectory)/../../mapkit/plugin/URAH_MapKit.csproj')">
    <Reference Include="URAH_MapKit" HintPath="$(BepInExPlugins)/URAH_MapKit/URAH_MapKit.dll" Private="false" />
  </ItemGroup>

  <Target Name="Deploy" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExPlugins)/URAH_HRE" />
  </Target>

</Project>
